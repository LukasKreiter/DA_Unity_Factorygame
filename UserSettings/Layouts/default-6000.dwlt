    \"m_ObjectId\": \"d70e0b1d9fa44f8fa988a71a9c46510f\",\n    \"m_Title\": \"LayerHex\",\n   
    \"m_Content\": \"This terrain layer type uses a grid of tiled hexagons where
    each hex tile has a unique scale and offset applied.  This method allows the
    terrain textures to be tiled infinitely without any repetition.  It costs a bit
    more than some of the other techniques because each texture needs to be sampled
    three times, but it is the most effective method for removing terrain tiling
    artifacts.\",\n    \"m_TextSize\": 0,\n    \"m_Theme\": 0,\n    \"m_Position\":
    {\n        \"serializedVersion\": \"2\",\n        \"x\": -172.00001525878907,\n       
    \"y\": -747.5000610351563,\n        \"width\": 285.0000305175781,\n        \"height\":
    140.5\n    },\n    \"m_Group\": {\n        \"m_Id\": \"\"\n    }\n}\n\n{\n   
