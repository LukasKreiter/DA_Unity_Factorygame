    \"m_Space\": 2\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.StickyNoteData\",\n   
    \"m_ObjectId\": \"38d116d208e64441897b41b2009492aa\",\n    \"m_Title\": \"AngleMask\",\n   
    \"m_Content\": \"creates a black to white gradient based on the facing angle
    of the surface - whether it\u2019s horizontal or vertical. The mask is white
    where the terrain is facing straight up (flat) and black where it\u2019s steep. 
    The gradient can be adjusted using the MaskCenter and MaskContrast values.  The
    MaskCenter value moves the black point of the gradient and the MaskContrast smooths
    or sharpens the mask.\\r\\n\",\n    \"m_TextSize\": 0,\n    \"m_Theme\": 0,\n   
    \"m_Position\": {\n        \"serializedVersion\": \"2\",\n        \"x\": -127.33333587646485,\n       
    \"y\": -394.66668701171877,\n        \"width\": 351.5000305175781,\n        \"height\":
    129.50001525878907\n    },\n    \"m_Group\": {\n        \"m_Id\": \"\"\n    }\n}\n\n{\n   
